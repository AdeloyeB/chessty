DATABASE_URL=postgresql://localhost:5432/chess_game
JWT_SECRET=your-super-secret-jwt-key-change-in-production
GOOGLE_CLIENT_ID=your-google-client-id
GOOGLE_CLIENT_SECRET=your-google-client-secret
GITHUB_CLIENT_ID=your-github-client-id
GITHUB_CLIENT_SECRET=your-github-client-secret
PORT=3001
CORS_ORIGIN=http://localhost:3000

# Redis (for game state persistence)
REDIS_URL=redis://localhost:6379

# Discord Bot (optional - bot won't start if not configured)
DISCORD_BOT_TOKEN=your-discord-bot-token
DISCORD_CLIENT_ID=your-discord-application-id
DISCORD_GUILD_ID=your-test-server-id  # Optional: for dev, restricts commands to one server
DISCORD_ENABLED=true  # Set to 'false' to disable bot
