{
  "name": "@chess-game/server",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "bun run --watch src/index.ts",
    "build": "bun build src/index.ts --outdir ./dist --target bun",
    "start": "bun run dist/index.js",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:push": "drizzle-kit push",
    "db:studio": "drizzle-kit studio"
  },
  "dependencies": {
    "@chess-game/shared": "workspace:*",
    "drizzle-orm": "^0.30.0",
    "postgres": "^3.4.4",
    "bcrypt": "^5.1.1",
    "jose": "^5.2.0",
    "nanoid": "^5.0.6",
    "chess.js": "^1.0.0",
    "zod": "^3.23.0"
  },
  "devDependencies": {
    "@types/bcrypt": "^5.0.2",
    "@types/bun": "latest",
    "drizzle-kit": "^0.21.0",
    "typescript": "^5.4.0"
  }
}
