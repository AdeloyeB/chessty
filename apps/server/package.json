{
  "name": "@chess-game/server",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "bun run --watch src/index.ts",
    "build": "bun build src/index.ts --outdir ./dist --target bun",
    "start": "bun run dist/index.js",
    "lint": "eslint src/",
    "test": "bun test",
    "test:watch": "bun test --watch",
    "test:wallet-service": "bun test src/services/walletAuth.service.test.ts",
    "test:wallet-routes": "bun test src/routes/walletAuth.routes.test.ts",
    "test:redis": "bun test src/redis/",
    "test:settlement": "bun test src/services/settlement/",
    "test:jury": "bun test src/services/jury/",
    "test:anticheat": "bun test src/services/anticheat/",
    "test:events": "bun test src/events/handlers/",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:push": "drizzle-kit push",
    "db:studio": "drizzle-kit studio"
  },
  "dependencies": {
    "@chess-game/shared": "workspace:*",
    "@neondatabase/serverless": "^1.0.2",
    "drizzle-orm": "^0.45.1",
    "ioredis": "^5.9.2",
    "jose": "^5.2.0",
    "nanoid": "^5.0.6",
    "otpauth": "^9.4.1",
    "zod": "^3.23.0"
  },
  "devDependencies": {
    "@types/bun": "latest",
    "drizzle-kit": "^0.31.8",
    "typescript": "^5.4.0"
  }
}
