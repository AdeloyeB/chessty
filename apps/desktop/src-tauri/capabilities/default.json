{
  "$schema": "https://raw.githubusercontent.com/tauri-apps/tauri/dev/crates/tauri-utils/schema/capability.json",
  "identifier": "default",
  "description": "Default permissions for the Chess Gamble desktop app",
  "windows": ["main"],
  "permissions": [
    "core:default",
    "opener:allow-open-url",
    "store:allow-get",
    "store:allow-set",
    "store:allow-delete",
    "store:allow-clear",
    "deep-link:default"
  ]
}
