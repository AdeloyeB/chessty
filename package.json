{
  "name": "the-chess-game",
  "version": "1.0.0",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "packageManager": "pnpm@9.0.0",
  "scripts": {
    "dev": "turbo dev",
    "build": "turbo build",
    "lint": "turbo lint",
    "clean": "turbo clean",
    "dev:web": "turbo dev --filter=@chess-game/web",
    "dev:server": "turbo dev --filter=@chess-game/server",
    "dev:desktop": "turbo dev --filter=@chess-game/desktop",
    "build:desktop": "turbo build --filter=@chess-game/desktop",
    "db:generate": "pnpm --filter=@chess-game/server db:generate",
    "db:migrate": "pnpm --filter=@chess-game/server db:migrate",
    "db:studio": "pnpm --filter=@chess-game/server db:studio",
    "test": "pnpm --filter=@chess-game/server test",
    "test:coverage": "pnpm --filter=@chess-game/server test --coverage",
    "prepare": "husky"
  },
  "devDependencies": {
    "husky": "^9.1.7",
    "turbo": "^2.0.0",
    "typescript": "^5.4.0"
  }
}
